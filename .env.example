# InSales App Configuration
INSALES_APP_ID=your-app-id
INSALES_APP_SECRET=replace-with-your-application-secret
APP_BASE_URL=http://127.0.0.1:8765
ALLOWED_SHOPS=your-shop.myinsales.ru

# Database
APP_DB=runtime/app.sqlite3

# Server
BIND_HOST=127.0.0.1
PORT=8765

# Процесс сам читает .env и не перезаписывает уже заданные переменные.
# Сгенерируйте ключ один раз до db upgrade и serve и сохраните его вместе
# с резервной копией SQLite: openssl rand -hex 32
# Следующий запуск использует этот же ключ и сам новый не создаёт.
ENCRYPTION_KEY=

# Logging
LOG_LEVEL=info