# InSales App Configuration
INSALES_APP_ID=your-app-id
INSALES_APP_SECRET=replace-with-your-application-secret
APP_BASE_URL=http://127.0.0.1:8765
ALLOWED_SHOPS=your-shop.myinsales.ru

# Database
APP_DB=runtime/app.sqlite3

# Server
BIND_HOST=127.0.0.1
PORT=8765

# Encryption key for store passwords (32 bytes hex, generate with: openssl rand -hex 32)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Logging
LOG_LEVEL=info